{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "crm",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5173,
      "autoPort": true,
      "env": {
        "NODE_OPTIONS": "--use-system-ca"
      }
    },
    {
      "name": "website",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "website", "run", "dev"],
      "port": 3000,
      "autoPort": true,
      "env": {
        "NODE_OPTIONS": "--use-system-ca"
      }
    }
  ]
}
